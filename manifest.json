{
  "manifest_version": "0.3",
  "name": "npi-providers-mcp-server",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "description": "Search NPPES providers and resolve NUCC specialty codes via MCP over STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://caseyjhand.com"
  },
  "repository": { "type": "git", "url": "https://github.com/cyanheads/npi-providers-mcp-server" },
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "NPI_CLAMP_LIMITS": "${user_config.clamp_limits}",
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production"
      }
    }
  },
  "compatibility": {
    "runtimes": { "node": ">=24.0.0" }
  },
  "tools_generated": true,
  "prompts_generated": false,
  "user_config": {
    "clamp_limits": {
      "type": "boolean",
      "title": "Clamp oversized limits",
      "description": "Clamp oversized limits and provider batches. Disable to restore strict upper bounds.",
      "default": true,
      "required": false
    }
  }
}
