{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "npi-providers-mcp-server",
  "version": "0.4.1",
  "description": "Search NPPES providers and resolve NUCC specialty codes via MCP over STDIO or Streamable HTTP.",
  "author": {
    "name": "Casey Hand",
    "email": "casey@caseyjhand.com",
    "url": "https://caseyjhand.com"
  },
  "homepage": "https://github.com/cyanheads/npi-providers-mcp-server",
  "repository": "https://github.com/cyanheads/npi-providers-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol"],
  "userConfig": {
    "clamp_limits": {
      "type": "boolean",
      "title": "Clamp oversized limits",
      "description": "Clamp oversized limits and provider batches. Disable to restore strict upper bounds.",
      "default": true,
      "required": false
    }
  },
  "mcpServers": {
    "npi-providers-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/npi-providers-mcp-server"],
      "env": {
        "NPI_CLAMP_LIMITS": "${user_config.clamp_limits}",
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
